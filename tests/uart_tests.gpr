with "../gnat/aa_stm32_drivers.gpr";
with "a0b_callbacks.gpr";

project UART_Tests is
   for Source_Dirs use (".", "../demos/linux");
   for Main use ("uart_tests.adb", "test_uart.adb", "workers_tests.adb",
      "multi_uart_tests.adb");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-g");
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use ("-lutil");
   end Linker;
end UART_Tests;
